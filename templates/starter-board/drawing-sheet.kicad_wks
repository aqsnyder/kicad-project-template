(kicad_wks (version 20231118) (generator "pl_editor") (generator_version "8.0")
  (setup (textsize 1.5 1.5)(linewidth 0.15)(textlinewidth 0.15)
  (left_margin 10)(right_margin 10)(top_margin 10)(bottom_margin 10))
  (rect (name "") (start 0 0 ltcorner) (end 0 0) (repeat 2) (incrx 2) (incry 2))
  (line (name "") (start 50 2 ltcorner) (end 50 0 ltcorner) (repeat 30) (incrx 50))
  (tbtext "1" (name "") (pos 25 1 ltcorner) (font (size 1.3 1.3)) (repeat 100) (incrx 50))
  (line (name "") (start 50 2 lbcorner) (end 50 0 lbcorner) (repeat 30) (incrx 50))
  (tbtext "1" (name "") (pos 25 1 lbcorner) (font (size 1.3 1.3)) (repeat 100) (incrx 50))
  (line (name "") (start 0 50 ltcorner) (end 2 50 ltcorner) (repeat 30) (incry 50))
  (tbtext "A" (name "") (pos 1 25 ltcorner) (font (size 1.3 1.3)) (justify center) (repeat 100) (incrlabel 1) (incry 50))
  (line (name "") (start 0 50 rtcorner) (end 2 50 rtcorner) (repeat 30) (incry 50))
  (tbtext "A" (name "") (pos 1 25 rtcorner) (font (size 1.3 1.3)) (justify center) (repeat 100) (incrlabel 1) (incry 50))
  (rect (name "") (start 189 44) (end 2 2) (comment "Title block outline"))
  (line (name "") (start 147 2) (end 147 44) (comment "Logo box, left of the fields"))
  (line (name "") (start 2 12.5) (end 147 12.5))
  (line (name "") (start 2 23) (end 147 23))
  (line (name "") (start 2 33.5) (end 112.5 33.5))
  (line (name "") (start 112.5 12.5) (end 112.5 44))
  (line (name "") (start 78 2) (end 78 23))
  (line (name "") (start 43.5 2) (end 43.5 44))
  (line (name "") (start 27.5 2) (end 27.5 12.5))
  (line (name "") (start 19.5 12.5) (end 19.5 23))
  (tbtext "Comments:" (name "") (pos 145.5 42) (font (face "Arial") (color 0 0 255 1)))
  (tbtext "${COMMENT1}" (name "") (pos 145.5 37.5) (font (face "Times New Roman") (color 0 0 127 1)) (maxlen 32))
  (tbtext "${COMMENT2}" (name "") (pos 145.5 34) (font (face "Times New Roman") (color 0 0 127 1)) (maxlen 32))
  (tbtext "${COMMENT3}" (name "") (pos 145.5 30.5) (font (face "Times New Roman") (color 0 0 127 1)) (maxlen 32))
  (tbtext "${COMMENT4}" (name "") (pos 145.5 27) (font (face "Times New Roman") (color 0 0 127 1)) (maxlen 32))
  (tbtext "Company:" (name "") (pos 111 42) (font (face "Arial") (color 0 0 255 1)))
  (rect (name "") (start 185 40) (end 151 6) (comment "Placeholder logo: titleblock.py --logo PNG puts yours here"))
  (tbtext "LOGO" (name "") (pos 168 23) (font (size 2.5 2.5) bold) (justify center))
  (tbtext "${COMPANY}" (name "") (pos 111 37.5) (font (face "Times New Roman") bold (color 0 0 127 1)) (maxlen 66.5))
  (tbtext "Variant:" (name "") (pos 42 42) (font (face "Arial") (color 0 0 255 1)))
  (tbtext "${VARIANT}" (name "") (pos 42 37.5) (font (face "Times New Roman") (color 0 0 127 1)) (maxlen 39))
  (tbtext "Board Name:" (name "") (pos 111 31.5) (font (face "Arial") (color 0 0 255 1)))
  (tbtext "${BOARD_NAME}" (name "") (pos 111 27) (font (face "Times New Roman") (size 2.5 2.5) bold (color 0 0 127 1)) (maxlen 66.5))
  (tbtext "Project Name:" (name "") (pos 42 31.5) (font (face "Arial") (color 0 0 255 1)))
  (tbtext "${PROJECT_NAME}" (name "") (pos 42 27) (font (face "Times New Roman") (size 2.5 2.5) bold (color 0 0 127 1)) (maxlen 39))
  (tbtext "Sheet Title:" (name "") (pos 145.5 21) (font (face "Arial") (color 0 0 255 1)))
  (tbtext "${TITLE}" (name "") (pos 145.5 16.5) (font (face "Times New Roman") (color 0 0 127 1)) (maxlen 32))
  (tbtext "File Name:" (name "") (pos 111 21) (font (face "Arial") (color 0 0 255 1)))
  (tbtext "${FILENAME}" (name "") (pos 111 16.5) (font (face "Times New Roman") (color 0 0 127 1)) (maxlen 32))
  (tbtext "Designer:" (name "") (pos 76.5 21) (font (face "Arial") (color 0 0 255 1)))
  (tbtext "${DESIGNER}" (name "") (pos 76.5 16.5) (font (face "Times New Roman") (color 0 0 127 1)) (maxlen 32))
  (tbtext "Date:" (name "") (pos 42 21) (font (face "Arial") (color 0 0 255 1)))
  (tbtext "${ISSUE_DATE}" (name "") (pos 42 16.5) (font (face "Times New Roman") (color 0 0 127 1)) (maxlen 21.5))
  (tbtext "Revision:" (name "") (pos 18 21) (font (face "Arial") (color 0 0 255 1)))
  (tbtext "${REVISION}" (name "") (pos 18 16.5) (font (face "Times New Roman") (color 0 0 127 1)) (maxlen 15))
  (tbtext "Sheet Path:" (name "") (pos 145.5 10.5) (font (face "Arial") (color 0 0 255 1)))
  (tbtext "${SHEETPATH}" (name "") (pos 145.5 6) (font (face "Times New Roman") (color 0 0 127 1)) (maxlen 66.5))
  (tbtext "Reviewer:" (name "") (pos 76.5 10.5) (font (face "Arial") (color 0 0 255 1)))
  (tbtext "${REVIEWER}" (name "") (pos 76.5 6) (font (face "Times New Roman") (color 0 0 127 1)) (maxlen 32))
  (tbtext "Size:" (name "") (pos 42 10.5) (font (face "Arial") (color 0 0 255 1)))
  (tbtext "${PAPER}" (name "") (pos 41 6) (font (face "Times New Roman") (size 2.5 2.5) bold (color 0 0 127 1)))
  (tbtext "Sheet:" (name "") (pos 26 10.5) (font (face "Arial") (color 0 0 255 1)))
  (tbtext "${#}" (name "") (pos 25.6 6) (font (face "Times New Roman") (size 2.5 2.5) bold (color 0 0 127 1)))
  (tbtext "of" (name "") (pos 17.5 5.5) (font (face "Arial") (color 0 0 255 1)))
  (tbtext "${##}" (name "") (pos 14 6) (font (face "Times New Roman") (size 2.5 2.5) bold (color 0 0 127 1)))
  (tbtext "${KICAD_VERSION}" (name "") (pos 187.5 3.4) (font (size 1 1)) (maxlen 39))
)
