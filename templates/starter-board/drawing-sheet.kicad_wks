(kicad_wks (version 20231118) (generator "pl_editor") (generator_version "8.0")
  (setup (textsize 1.5 1.5)(linewidth 0.15)(textlinewidth 0.15)
  (left_margin 10)(right_margin 10)(top_margin 10)(bottom_margin 10))
  (rect (name "") (start 0 0 ltcorner) (end 0 0) (repeat 2) (incrx 2) (incry 2))
  (line (name "") (start 50 2 ltcorner) (end 50 0 ltcorner) (repeat 30) (incrx 50))
  (tbtext "1" (name "") (pos 25 1 ltcorner) (font (size 1.3 1.3)) (repeat 100) (incrx 50))
  (line (name "") (start 50 2 lbcorner) (end 50 0 lbcorner) (repeat 30) (incrx 50))
  (tbtext "1" (name "") (pos 25 1 lbcorner) (font (size 1.3 1.3)) (repeat 100) (incrx 50))
  (line (name "") (start 0 50 ltcorner) (end 2 50 ltcorner) (repeat 30) (incry 50))
  (tbtext "A" (name "") (pos 1 25 ltcorner) (font (size 1.3 1.3)) (justify center) (repeat 100) (incrlabel 1) (incry 50))
  (line (name "") (start 0 50 rtcorner) (end 2 50 rtcorner) (repeat 30) (incry 50))
  (tbtext "A" (name "") (pos 1 25 rtcorner) (font (size 1.3 1.3)) (justify center) (repeat 100) (incrlabel 1) (incry 50))
  (rect (name "") (start 122 42) (end 2 2) (comment "Title block outline"))
  (line (name "") (start 122 22) (end 2 22))
  (line (name "") (start 122 12) (end 2 12))
  (line (name "") (start 122 7) (end 2 7))
  (line (name "") (start 92 42) (end 92 22) (comment "Logo cell"))
  (line (name "") (start 97 12) (end 97 7))
  (line (name "") (start 57 12) (end 57 7))
  (line (name "") (start 32 12) (end 32 2))
  (rect (name "") (start 119 39) (end 95 25) (comment "Placeholder logo: replace with your bitmap in the Drawing Sheet Editor"))
  (tbtext "LOGO" (name "") (pos 107 32) (font (size 2.5 2.5) bold) (justify center))
  (tbtext "${COMPANY}" (name "") (pos 90 38) (font (size 2.5 2.5) bold) (maxlen 86))
  (tbtext "Designed by: ${DESIGNER}" (name "") (pos 90 32.5) (maxlen 86))
  (tbtext "${COMMENT1}" (name "") (pos 90 28.5) (maxlen 86))
  (tbtext "${COMMENT2}" (name "") (pos 90 24.5) (maxlen 86))
  (tbtext "Title: ${TITLE}" (name "") (pos 120 17) (font (size 2 2) bold) (maxlen 116))
  (tbtext "Size: ${PAPER}" (name "") (pos 120 9.5) (maxlen 22))
  (tbtext "Date: ${ISSUE_DATE}" (name "") (pos 95 9.5) (maxlen 37))
  (tbtext "Rev: ${REVISION}" (name "") (pos 55 9.5) (maxlen 22))
  (tbtext "Sheet: ${#}/${##}" (name "") (pos 30 9.5) (maxlen 27))
  (tbtext "File: ${FILENAME}" (name "") (pos 120 4.5) (maxlen 86))
  (tbtext "${KICAD_VERSION}" (name "") (pos 30 4.5) (font (size 1.2 1.2)) (maxlen 27))
)
