(version 1)
# PCBWay, standard PCB service, no surcharge.
# Sources (checked 2026-10-25):
#   https://www.pcbway.com/capabilities.html
#   https://www.pcbway.com/advanced-pcb-capabilities.html (hole spacing, edge clearance, inner-layer ring)
# Copy to <project>.kicad_dru next to the .kicad_pro. KiCad only reads that file name.

(rule "PCBWay: track width"
	(constraint track_width (min 0.1mm))
	(condition "A.Type == 'track'"))

(rule "PCBWay: copper clearance"
	(constraint clearance (min 0.1mm)))

# Holes under 0.2 mm cost extra (absolute minimum 0.15 mm).
(rule "PCBWay: hole size, no surcharge"
	(constraint hole_size (min 0.2mm)))

(rule "PCBWay: annular ring"
	(constraint annular_width (min 0.15mm)))

# Normal tier: 11 mil between via holes, 16 mil between component holes.
(rule "PCBWay: via hole to hole"
	(constraint hole_to_hole (min 0.28mm))
	(condition "A.Type == 'Via' && B.Type == 'Via'"))

(rule "PCBWay: pad hole to hole"
	(constraint hole_to_hole (min 0.4mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad'"))

# Inner-layer isolation ring for 4 layers (7 mil); 6 layers need 8 mil.
(rule "PCBWay: hole to copper, inner layers"
	(constraint hole_clearance (min 0.18mm))
	(layer inner))

# CNC-routed edge, normal tier.
(rule "PCBWay: copper to board edge"
	(constraint edge_clearance (min 0.25mm)))

(rule "PCBWay: silkscreen text"
	(constraint text_height (min 0.8mm))
	(constraint text_thickness (min 0.15mm))
	(layer "?.Silkscreen"))
