(version 1)
# fab-profile: jlcpcb-2layer
# fab-name: JLCPCB 1-2 layer
# copper-layers: 1-2
# JLCPCB, 1-2 layer, 1 oz copper, using only options with no extra charge.
# Source (checked 2026-10-26): https://jlcpcb.com/capabilities/pcb-capabilities
#
# Board Setup > Constraints. hw/fab.py writes these into the project. They are floors: net class clearances and
# widths above them still apply.
# board-setup: min_clearance 0.1
# board-setup: min_track_width 0.1
# board-setup: min_through_hole_diameter 0.2
# board-setup: min_via_diameter 0.45
# board-setup: min_via_annular_width 0.05
# board-setup: min_hole_clearance 0.2
# board-setup: min_hole_to_hole 0.2
# board-setup: min_copper_edge_clearance 0.2
# board-setup: min_text_height 1
# board-setup: min_text_thickness 0.15
#
# Notes:
# - Vias: 0.2 mm holes need a 0.45 mm diameter to avoid the surcharge; 0.15 mm holes always cost extra.
# - JLCPCB also asks for 0.15 mm between SMD pads on different nets. A rule for it would replace the net class
#   clearance between pads, so keep net class clearances at 0.15 mm or more instead.
# - Copper to a routed edge: 0.2 mm; to a V-cut: 0.4 mm.
# - Silkscreen: 1 mm text height with a 0.15 mm stroke.

(rule "JLCPCB: plated pad annular ring"
	(constraint annular_width (min 0.18mm))
	(condition "A.Type == 'Pad' && A.isPlated()"))

(rule "JLCPCB: NPTH hole size"
	(constraint hole_size (min 0.5mm))
	(condition "A.Pad_Type == 'NPTH, mechanical'"))

(rule "JLCPCB: pad hole to hole"
	(constraint hole_to_hole (min 0.45mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad'"))

(rule "JLCPCB: plated hole to track"
	(constraint hole_clearance (min 0.28mm))
	(condition "(A.Type == 'Pad' && A.isPlated() && B.Type == 'Track') || (B.Type == 'Pad' && B.isPlated() && A.Type == 'Track')"))
